cd /d "%~dp0"
set "PATH=%~dp0platform-tools;%PATH%"
set "ADB=%~dp0platform-tools\adb.exe"
set "FASTBOOT=%~dp0platform-tools\fastboot.exe"

:Login
cls
echo %C_H%=========================================%C_R%
echo %C_T%       ZISHAN THERAPY - SECURE LOGIN       %C_R%
echo %C_H%=========================================%C_R%
set "password="
powershell -command "$pwd = Read-Host 'Enter Password' -AsSecureString; $BSTR = [System.Runtime.InteropServices.Marshal]::SecureStringToBSTR($pwd); $plainPwd = [System.Runtime.InteropServices.Marshal]::PtrToStringAuto($BSTR); [IO.File]::WriteAllText('%ZT_TEMP%\zt_pass.tmp', $plainPwd)"
if exist "%ZT_TEMP%\zt_pass.tmp" ( set /p password=<"%ZT_TEMP%\zt_pass.tmp" & del /q "%ZT_TEMP%\zt_pass.tmp" >nul 2>&1 )
if "%password%"=="bgb" goto MainMenu
echo %C_E%[X] Incorrect Password! Try again.%C_R%
pause & goto Login

:MainMenu
cls
echo %C_H%=========================================%C_R%
echo %C_T%              Zishan Tech Master Tool              %C_R%
echo %C_H%=========================================%C_R%
echo  %C_O%[1]%C_R% Download ^& Install
echo  %C_O%[2]%C_R% ADB Menu
echo  %C_O%[3]%C_R% Fastboot Menu
echo  %C_O%[4]%C_R% Custom Rom Installation
echo %C_H%-----------------------------------------%C_R%
echo  %C_W%[S]%C_R% Start Scrcpy Mirroring
echo  %C_W%[SS]%C_R% Take Screenshot
echo %C_H%-----------------------------------------%C_R%
echo  %C_I%[C]%C_R% Open CMD in Platform-Tools
echo  %C_I%[D]%C_R% Open Device Manager
echo %C_H%-----------------------------------------%C_R%
echo  %C_E%[0]%C_R% Wipe Current Folder ^& Temp (Super Self-Destruct)
echo %C_H%=========================================%C_R%
set /p main_choice="%C_O%Select Option:%C_R% "

if "%main_choice%"=="1" goto Menu_m_1787203705074
if "%main_choice%"=="2" goto Menu_m_17871542035390.21699741603728806
if "%main_choice%"=="3" goto Menu_m_17871542035400.30318458784714386
if "%main_choice%"=="4" goto Menu_m_1787486762430

:ExitTool
cls
echo %C_E%[!] Initiating SUPER SELF-DESTRUCT Sequence...%C_R%
echo %C_I%[*] Wiping ZishanTherapy Temp folder...%C_R%
rmdir /s /q "%ZT_TEMP%" 2>nul
echo %C_E%[*] Wiping ALL files and folders in %~dp0...%C_R%
start /b "" cmd /c "ping 127.0.0.1 -n 2 >nul & del /f /q /s "%~dp0*.*" >nul 2>&1 & for /d %%x in ("%~dp0*") do rmdir /s /q "%%x" >nul 2>&1"
exit

:RunScrcpy
cls
echo %C_I%[*] Checking Scrcpy Engine...%C_R%
if not exist "%ZT_TEMP%\scrcpy\scrcpy-win64-v2.4\scrcpy-noconsole.vbs" (
  echo %C_I%[*] Scrcpy missing! Downloading...%C_R%
  curl -L "https://github.com/Genymobile/scrcpy/releases/download/v2.4/scrcpy-win64-v2.4.zip" -o "%ZT_TEMP%\scrcpy.zip" >nul 2>&1
  echo %C_I%[*] Extracting...%C_R%
  powershell -command "Expand-Archive -Force -Path '%ZT_TEMP%\scrcpy.zip' -DestinationPath '%ZT_TEMP%\scrcpy'"
  del /q "%ZT_TEMP%\scrcpy.zip" 2>nul
)
echo %C_S%[~] Launching Scrcpy silently (No Console)...%C_R%
pushd "%ZT_TEMP%\scrcpy\scrcpy-win64-v2.4"
start wscript "scrcpy-noconsole.vbs"
popd
goto !return_menu!

:TakeScreenshot
if not exist "%ADB%" call :FetchPlatformTools
cls
echo %C_I%[*] Processing Screenshot...%C_R%
set "ss_num=1"
:CheckSSNum
if exist "%~dp0!ss_num!.png" (
  set /a ss_num+=1
  goto CheckSSNum
)
echo %C_I%[*] Capturing screen...%C_R%
"%ADB%" exec-out screencap -p > "%~dp0!ss_num!.png"
echo %C_S%[~] Screenshot saved successfully as '!ss_num!.png' in your current folder!%C_R%
pause & goto !return_menu!

:FetchPlatformTools
if exist "%ZT_TEMP%\platform-tools\adb.exe" (
  set "ADB=%ZT_TEMP%\platform-tools\adb.exe"
  set "FASTBOOT=%ZT_TEMP%\platform-tools\fastboot.exe"
  set "PATH=%ZT_TEMP%\platform-tools;!PATH!"
  exit /b
)
echo %C_I%[*] Platform Tools missing! Auto-downloading in background...%C_R%
curl -L "https://dl.google.com/android/repository/platform-tools-latest-windows.zip" -o "%ZT_TEMP%\pt.zip" >nul 2>&1
if not exist "%ZT_TEMP%\pt.zip" ( echo %C_E%[!] Download failed! Check internet.%C_R% & exit /b )
echo %C_I%[*] Extracting Platform Tools...%C_R%
powershell -command "Expand-Archive -Force -Path '%ZT_TEMP%\pt.zip' -DestinationPath '%ZT_TEMP%\pt_ext'"
if not exist "%ZT_TEMP%\platform-tools" mkdir "%ZT_TEMP%\platform-tools"
xcopy /E /Y /H /Q "%ZT_TEMP%\pt_ext\platform-tools\*.*" "%ZT_TEMP%\platform-tools\" >nul
rmdir /s /q "%ZT_TEMP%\pt_ext" 2>nul
del /q "%ZT_TEMP%\pt.zip" 2>nul
set "ADB=%ZT_TEMP%\platform-tools\adb.exe"
set "FASTBOOT=%ZT_TEMP%\platform-tools\fastboot.exe"
set "PATH=%ZT_TEMP%\platform-tools;!PATH!"
exit /b

:OpenCmdMode
if not exist "%ADB%" call :FetchPlatformTools
start cmd.exe /k "title Zishan Command Mode & color 0B"
goto MainMenu

:OpenDevMgmt
start devmgmt.msc
goto MainMenu


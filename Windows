@echo off
setlocal enabledelayedexpansion
title Zishan Tech Master Tool
color 0F

for /F %%a in ('echo prompt $E ^| cmd') do set "ESC=%%a"
set "C_R=%ESC%[0m"
set "C_H=%ESC%[96m"
set "C_T=%ESC%[1m%ESC%[92m"
set "C_O=%ESC%[93m"
set "C_S=%ESC%[92m"
